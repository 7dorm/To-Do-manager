<file path="src/main/java/ru/nsu/dunaev/Main.java">
package ru.nsu.dunaev;


import ru.nsu.dunaev.enums.Priority;
import ru.nsu.dunaev.enums.Status;
import ru.nsu.dunaev.interfaces.Analyzer;
import ru.nsu.dunaev.interfaces.OutputHandler;
import ru.nsu.dunaev.interfaces.ReportGenerator;
import ru.nsu.dunaev.realizations.ConsoleOutput;
import ru.nsu.dunaev.realizations.StatusAnalyzer;
import ru.nsu.dunaev.realizations.TaskReportGenerator;

import java.util.Map;
import java.util.UUID;

public class Main {
    public static void main(String[] args) {
        TaskManager<UUID> manager = new TaskManager<>();
        OutputHandler output = new ConsoleOutput();

        manager.addTask(new Task<>(UUID.randomUUID(), "Buy groceries", "Milk and Eggs", Priority.HIGH, Status.NEW));
        manager.addTask(new Task<>(UUID.randomUUID(), "Write report", "Prepare sales report", Priority.MEDIUM, Status.NEW));

        TaskUpdater<UUID> updater = new TaskUpdater<>();
        updater.parallelUpdateStatus(manager.getAllTasks(), Status.NEW, Status.IN_PROGRESS);

        Analyzer<Map<Status, Long>, UUID> analyzer = new StatusAnalyzer<>();
        Map<Status, Long> result = analyzer.analyze(manager.getAllTasks());

        ReportGenerator<Map<Status, Long>> report = new TaskReportGenerator<>(output);
        report.generateReport(result);

        updater.shutdown();
    }
}
</file>

